{
  "name": "worldnote",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=app-web",
    "dev:worldnote": "turbo run dev --filter=app-worldnote",
    "dev:storybook": "turbo run dev --filter=app-storybook",
    "dev:all": "turbo run dev --filter=./apps/*",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check --write .",
    "check": "biome check .",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tauri-apps/cli": "^2.2.7",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
