{
  "name": "@worldnote/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme/tailwind.css": "./src/theme/tailwind.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-brand-assets.mjs",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "lint": "biome check .",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "node -e \"process.exit(0)\""
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.2.45",
    "@fontsource-variable/urbanist": "^5.2.5",
    "@heroui/react": "^2.8.10",
    "@heroui/theme": "^2.4.26",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
