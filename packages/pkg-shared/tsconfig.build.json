{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@worldnote/shared": ["./src/index.ts"],
      "@worldnote/shared/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.test.ts",
    "node_modules",
    "dist",
    "src/components/tiptap-templates/simple/simple-editor.tsx",
    "src/components/tiptap-templates/simple/theme-toggle.tsx",
    "src/components/tiptap-node/image-upload-node",
    "src/components/tiptap-node/horizontal-rule-node",
    "src/components/tiptap-ui/image-upload-button"
  ]
}
