{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": [
      "**/node_modules",
      "**/dist",
      "**/.next",
      "**/target",
      "**/storybook-static",
      "**/.turbo",
      "**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "error"
      }
    }
  },
  "organizeImports": {
    "enabled": false
  },
  "overrides": [
    {
      "include": [
        "packages/pkg-ui/**/*.ts",
        "packages/pkg-ui/**/*.tsx",
        "packages/pkg-shared/**/*.ts",
        "packages/pkg-shared/**/*.tsx",
        "packages/canvas/**/*.ts",
        "packages/canvas/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "error"
          }
        }
      }
    },
    {
      "include": [
        "packages/pkg-shared/src/components/tiptap-*/**",
        "packages/pkg-shared/src/hooks/**",
        "packages/pkg-shared/src/lib/tiptap-utils.ts"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useSemanticElements": "off"
          },
          "complexity": {
            "noForEach": "off"
          },
          "correctness": {
            "useImportExtensions": "off",
            "useExhaustiveDependencies": "off"
          },
          "style": {
            "noUselessElse": "off",
            "noUnusedTemplateLiteral": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noControlCharactersInRegex": "off",
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
